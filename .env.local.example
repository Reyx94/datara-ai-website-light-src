# Copy to .env.local (gitignored) and fill from Supabase → Project Settings → API.
# NEVER commit real values. In Vercel, set these under Project → Settings → Environment Variables.

# Public (safe to expose to the browser; protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://eljofwsbjeczvkabpoyo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (privileged; bypasses RLS). Never prefix with NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend). Used for the welcome email after account confirmation.
# The from-address domain must be verified in Resend.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=peptides.cx <onboarding@peptides.cx>

# Note: the raw Postgres connection string (postgresql://...:5432/postgres) is NOT
# used by the app and must not be committed. It's only for running migrations from
# a trusted machine or the Supabase SQL editor.
